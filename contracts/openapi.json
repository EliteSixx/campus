  "components": {
    "schemas": {
      "Branch": {
        "type": "string",
        "enum": [
          "CSE",
          "IT",
          "ECE",
          "EEE",
          "ME",
          "CE",
          "OTHER"
        ],
        "title": "Branch"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Machine-readable, e.g. INVALID_INPUT."
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field",
            "description": "Dotted path to the bad field, e.g. student.cgpa."
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Job": {
        "properties": {
          "job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Id",
            "description": "Assigned when the job is saved; null straight after parsing."
          },
          "company": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "min_cgpa": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Min Cgpa",
            "default": 0
          },
          "max_backlogs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Backlogs",
            "description": "null = no limit stated."
          },
          "eligible_branches": {
            "items": {
              "$ref": "#/components/schemas/Branch"
            },
            "type": "array",
            "title": "Eligible Branches",
            "description": "Empty = all branches."
          },
          "required_skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Required Skills"
          },
          "preferred_skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Preferred Skills"
          },
          "experience_years": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Experience Years"
          },
          "ctc_lpa": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Ctc Lpa",
            "description": "Offered CTC in lakhs per annum."
          }
        },
        "type": "object",
        "required": [
          "role"
        ],
        "title": "Job"
      },
      "MatchRequest": {
        "properties": {
          "student": {
            "$ref": "#/components/schemas/Student"
          },
          "job": {
            "$ref": "#/components/schemas/Job"
          }
        },
        "type": "object",
        "required": [
          "student",
          "job"
        ],
        "title": "MatchRequest"
      },
      "MatchResponse": {
        "properties": {
          "student_id": {
            "type": "string",
            "title": "Student Id"
          },
          "job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Id"
          },
          "match_score": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Match Score"
          },
          "eligible": {
            "type": "boolean",
            "title": "Eligible"
          },
          "matched_skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matched Skills"
          },
          "skill_gaps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Skill Gaps"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/Reason"
            },
            "type": "array",
            "title": "Reasons"
          },
          "breakdown": {
            "items": {
              "$ref": "#/components/schemas/ScoreComponent"
            },
            "type": "array",
            "title": "Breakdown"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "type": "object",
        "required": [
          "student_id",
          "match_score",
          "eligible",
          "matched_skills",
          "skill_gaps",
          "reasons",
          "breakdown",
          "meta"
        ],
        "title": "MatchResponse"
      },
      "Meta": {
        "properties": {
          "engine_version": {
            "type": "string",
            "title": "Engine Version",
            "description": "Version of the AI engine that produced this response."
          },
          "stub": {
            "type": "boolean",
            "title": "Stub",
            "description": "True while the endpoint returns hardcoded stub data."
          }
        },
        "type": "object",
        "required": [
          "engine_version",
          "stub"
        ],
        "title": "Meta"
      },
      "MissingSkill": {
        "properties": {
          "skill": {
            "type": "string",
            "title": "Skill"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          }
        },
        "type": "object",
        "required": [
          "skill",
          "priority"
        ],
        "title": "MissingSkill"
      },
      "ParseJobRequest": {
        "properties": {
          "text": {
            "type": "string",
            "minLength": 10,
            "title": "Text",
            "description": "Raw job description text typed or pasted by the recruiter."
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ParseJobRequest"
      },
      "ParseJobResponse": {
        "properties": {
          "job": {
            "$ref": "#/components/schemas/Job"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings",
            "description": "Fields the parser could not find or was unsure about."
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "type": "object",
        "required": [
          "job",
          "confidence",
          "warnings",
          "meta"
        ],
        "title": "ParseJobResponse"
      },
      "PlacementActivity": {
        "properties": {
          "drives_applied": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Drives Applied",
            "default": 0
          },
          "shortlisted": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Shortlisted",
            "default": 0
          },
          "interviews_attended": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Interviews Attended",
            "default": 0
          },
          "rejections": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Rejections",
            "default": 0
          }
        },
        "type": "object",
        "title": "PlacementActivity"
      },
      "PredictPlacementRequest": {
        "properties": {
          "student": {
            "$ref": "#/components/schemas/Student"
          },
          "activity": {
            "$ref": "#/components/schemas/PlacementActivity"
          }
        },
        "type": "object",
        "required": [
          "student"
        ],
        "title": "PredictPlacementRequest"
      },
      "PredictPlacementResponse": {
        "properties": {
          "student_id": {
            "type": "string",
            "title": "Student Id"
          },
          "risk": {
            "$ref": "#/components/schemas/RiskLevel"
          },
          "probability_unplaced": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Probability Unplaced"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          },
          "interventions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Interventions"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "type": "object",
        "required": [
          "student_id",
          "risk",
          "probability_unplaced",
          "reasons",
          "interventions",
          "meta"
        ],
        "title": "PredictPlacementResponse"
      },
      "Priority": {
        "type": "string",
        "enum": [
          "HIGH",
          "MEDIUM",
          "LOW"
        ],
        "title": "Priority"
      },
      "Project": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "tech": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tech"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "Project"
      },
      "RankRequest": {
        "properties": {
          "job": {
            "$ref": "#/components/schemas/Job"
          },
          "students": {
            "items": {
              "$ref": "#/components/schemas/Student"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Students"
          }
        },
        "type": "object",
        "required": [
          "job",
          "students"
        ],
        "title": "RankRequest"
      },
      "RankResponse": {
        "properties": {
          "job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Id"
          },
          "ranked": {
            "items": {
              "$ref": "#/components/schemas/RankedMatch"
            },
            "type": "array",
            "title": "Ranked",
            "description": "Eligible candidates first, then ineligible; each group by score, highest first."
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "type": "object",
        "required": [
          "ranked",
          "meta"
        ],
        "title": "RankResponse"
      },
      "RankedMatch": {
        "properties": {
          "student_id": {
            "type": "string",
            "title": "Student Id"
          },
          "job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Id"
          },
          "match_score": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
